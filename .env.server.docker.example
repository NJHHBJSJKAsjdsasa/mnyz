# Copy to .env.server.docker for docker-compose.server.yml.
# Migrations run against PostgreSQL directly; the app goes through pgbouncer.
POSTGRES_PASSWORD=CHANGE_ME
ATLAS_ENV=staging
ATLAS_REDIS_URL=redis://redis:6379/0
ATLAS_CELERY_BROKER_URL=redis://redis:6379/1
ATLAS_SECRET_KEY=CHANGE_ME_AT_LEAST_32_BYTES_LONG
ATLAS_JWT_PRIVATE_KEY=/run/secrets/dev_jwt_private.pem
ATLAS_JWT_PUBLIC_KEY=/run/secrets/dev_jwt_public.pem
ATLAS_JWT_KID=2026-10
ATLAS_LOG_LEVEL=info
