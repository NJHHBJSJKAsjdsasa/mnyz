# Atlas API image. Build context = repository root.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt

COPY alembic.ini ./
COPY server ./server

RUN useradd --create-home --uid 10001 atlas && chown -R atlas:atlas /app
USER atlas

EXPOSE 8000

# Flask is WSGI; gthread workers are the correct gunicorn mode (not UvicornWorker).
CMD ["gunicorn", "-k", "gthread", "-w", "4", \
     "--max-requests", "2000", "--max-requests-jitter", "200", \
     "--timeout", "30", "--bind", "0.0.0.0:8000", "server.wsgi:application"]
