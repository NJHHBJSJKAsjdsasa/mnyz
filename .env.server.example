# Copy to .env.server (never commit the real file).
# Local bootstrap: python -m server.cli init-dev --dsn "postgresql://postgres:...@127.0.0.1:5432/atlas"
ATLAS_ENV=dev
ATLAS_DATABASE_URL=postgresql://atlas_app:CHANGE_ME@127.0.0.1:6432/atlas
ATLAS_REDIS_URL=redis://127.0.0.1:6379/0
ATLAS_SECRET_KEY=CHANGE_ME_AT_LEAST_32_BYTES_LONG
ATLAS_JWT_PRIVATE_KEY=/run/secrets/atlas_jwt_private.pem
ATLAS_JWT_PUBLIC_KEY=/run/secrets/atlas_jwt_public.pem
ATLAS_JWT_KID=2026-10
ATLAS_LOG_LEVEL=info
ATLAS_EXPECTED_REVISION=0114_company_law_court
ATLAS_DB_POOL_MAX=10
# Planet cache cutover (pymodules/__atlas_cache_facade.py)
# Optional: pin the cache universe for CLI/backfill outside a request context.
# ATLAS_UNIVERSE_ID=
ATLAS_CACHE_BACKEND=sqlite
# Browser origins allowed to call /api/v1 during the shadow/cutover phases.
ATLAS_CORS_ORIGINS=http://127.0.0.1:6424,http://localhost:6424
ATLAS_CACHE_DUAL_WRITE=false
ATLAS_CACHE_SQLITE_FALLBACK=true
ATLAS_CACHE_MAX_GALAXIES=500000
ATLAS_CACHE_MAX_SYSTEMS=2000000
ATLAS_CACHE_MAX_PLANETS=5000000
ATLAS_ACCESS_TTL=900
ATLAS_REFRESH_TTL=2592000
# off only for local test runs; production must keep rate limits on
ATLAS_RATE_LIMIT=on
